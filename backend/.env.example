PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://planos:planos@localhost:5432/planos
PG_POOL_MAX=10
# Obligatorio cambiarlo en producción (el servidor no arranca con el valor por defecto)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Carpeta para planos, fotos y documentos (driver local). Futuro: S3/MinIO.
STORAGE_DIR=./storage
# Opcional: raíces separadas por tipo (en producción /data/plans, /data/uploads, /data/documents)
# PLANS_DIR=
# UPLOADS_DIR=
# DOCUMENTS_DIR=
MAX_UPLOAD_MB=25

# Usuario administrador inicial (npm run seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
