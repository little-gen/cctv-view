# =============================================================================
# PlanosCámaras · variables de producción
#   cp .env.example .env && chmod 600 .env && nano .env
# Genera los secretos con:  openssl rand -hex 32
# Usa solo [a-z0-9] en las contraseñas (van dentro de una URL de conexión).
# =============================================================================

# --- Publicación
DOMAIN=cctv.midominio.com
LETSENCRYPT_EMAIL=admin@midominio.com
# 1 = certificados de prueba (staging) para validar la configuración sin agotar límites
LETSENCRYPT_STAGING=0
TZ=Europe/Madrid

# --- Versión de las imágenes de la aplicación (update.sh la fija al commit desplegado)
APP_VERSION=latest

# --- Rutas de datos en la VM (disco dedicado montado en /data)
DATA_DIR=/data

# --- PostgreSQL
POSTGRES_DB=cctv
POSTGRES_USER=cctv
POSTGRES_PASSWORD=CAMBIAR_openssl_rand_hex_32
# Rol sin privilegios con el que se conecta la aplicación (lo crea el backend al arrancar).
# Vacío = la aplicación usa el propietario de la BD (no recomendado).
POSTGRES_APP_USER=cctv_app
POSTGRES_APP_PASSWORD=CAMBIAR_openssl_rand_hex_32

# --- Backend
JWT_SECRET=CAMBIAR_openssl_rand_hex_48
JWT_EXPIRES_IN=8h
# Fotos y documentos
MAX_UPLOAD_MB=25
# Documentación de la API (/api/docs) en producción: false salvo para depurar
API_DOCS=false
# Planos (si se sube, ajustar también client_max_body_size en nginx/templates/cctv.conf.template)
PLAN_MAX_UPLOAD_MB=200
# Resolución de visualización: los planos mayores se reducen a esto (400 Mpx ≈ 20.000 × 20.000 px).
# El original se conserva. Procesar un plano grande usa ~1 GB de RAM durante unos segundos.
PLAN_MAX_MEGAPIXELS=400
# Por encima de esto el plano se rechaza (protección frente a imágenes malintencionadas)
PLAN_MAX_INPUT_MEGAPIXELS=2000

# --- Copias de seguridad (cron del contenedor "backup", hora local de TZ)
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Instantáneas incrementales de /data/plans, /data/uploads y /data/documents
BACKUP_FILES=true
BACKUP_FILES_RETENTION_DAYS=14

# --- Acceso a /api/health a través de nginx (red de monitorización). Por defecto, nadie de fuera.
HEALTH_ALLOW=127.0.0.1

# --- Monitorización (opcional: docker-compose.monitoring.yml)
# 127.0.0.1 = solo accesible por túnel SSH. Para la LAN de administración, la IP de la VM.
MONITORING_BIND=127.0.0.1
GRAFANA_ADMIN_PASSWORD=CAMBIAR_openssl_rand_hex_16
POSTGRES_EXPORTER_PASSWORD=CAMBIAR_openssl_rand_hex_16
