[Unit]
Description=PlanosCamaras - actualizacion automatica (git pull + docker compose)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__/deploy
ExecStart=__REPO__/deploy/scripts/update.sh
TimeoutStartSec=45min
Nice=10
